<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/loginScreen">

    <fragment
        android:id="@+id/loginScreen"
        android:name="com.riversongai.ui.LoginScreen"
        android:label="Sign In"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginScreen_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginScreen_to_registerScreen"
            app:destination="@id/registerScreen" />
    </fragment>

    <fragment
        android:id="@+id/registerScreen"
        android:name="com.riversongai.ui.RegisterScreen"
        android:label="Create Account"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerScreen_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.riversongai.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.riversongai.ui.ChatFragment"
        android:label="River Song"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="message"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/smartHomeControlScreen"
        android:name="com.riversongai.ui.SmartHomeControlScreen"
        android:label="Devices"
        tools:layout="@layout/fragment_smart_home_control" />

    <fragment
        android:id="@+id/feedsFragment"
        android:name="com.riversongai.ui.FeedsFragment"
        android:label="Feeds"
        tools:layout="@layout/fragment_feeds" />

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.riversongai.ui.MoreFragment"
        android:label="More"
        tools:layout="@layout/fragment_more">
        <action
            android:id="@+id/action_moreFragment_to_memoryFragment"
            app:destination="@id/memoryFragment" />
        <action
            android:id="@+id/action_moreFragment_to_routinesFragment"
            app:destination="@id/routinesFragment" />
        <action
            android:id="@+id/action_moreFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_moreFragment_to_feedSettingsFragment"
            app:destination="@id/feedSettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/memoryFragment"
        android:name="com.riversongai.ui.MemoryFragment"
        android:label="Memory"
        tools:layout="@layout/fragment_memory" />

    <fragment
        android:id="@+id/routinesFragment"
        android:name="com.riversongai.ui.RoutinesFragment"
        android:label="Routines"
        tools:layout="@layout/fragment_routines" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.riversongai.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/feedSettingsFragment"
        android:name="com.riversongai.ui.FeedSettingsFragment"
        android:label="Feed Settings"
        tools:layout="@layout/fragment_feed_settings" />

    <fragment
        android:id="@+id/userDashboardScreen"
        android:name="com.riversongai.ui.UserDashboardScreen"
        android:label="Profile"
        tools:layout="@layout/fragment_user_dashboard" />

</navigation>
