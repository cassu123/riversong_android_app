<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/loginScreen">

    <!-- ── Auth ──────────────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/loginScreen"
        android:name="com.riversongai.ui.LoginScreen"
        android:label="Sign In"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginScreen_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginScreen_to_registerScreen"
            app:destination="@id/registerScreen" />
    </fragment>

    <fragment
        android:id="@+id/registerScreen"
        android:name="com.riversongai.ui.RegisterScreen"
        android:label="Create Account"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerScreen_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginScreen"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ── Bottom nav destinations ───────────────────────────────────────── -->

    <fragment
        android:id="@+id/speakFragment"
        android:name="com.riversongai.ui.SpeakFragment"
        android:label="Speak"
        tools:layout="@layout/fragment_speak" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.riversongai.ui.ChatFragment"
        android:label="River Song"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="message"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/feedsFragment"
        android:name="com.riversongai.ui.FeedsFragment"
        android:label="Feeds"
        tools:layout="@layout/fragment_feeds" />

    <!-- ── Drawer main destinations ──────────────────────────────────────── -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.riversongai.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_smartHomeControlScreen"
            app:destination="@id/smartHomeControlScreen" />
    </fragment>

    <fragment
        android:id="@+id/smartHomeControlScreen"
        android:name="com.riversongai.ui.SmartHomeControlScreen"
        android:label="Smart Home"
        tools:layout="@layout/fragment_smart_home_control" />

    <fragment
        android:id="@+id/memoryFragment"
        android:name="com.riversongai.ui.MemoryFragment"
        android:label="Memory"
        tools:layout="@layout/fragment_memory" />

    <fragment
        android:id="@+id/routinesFragment"
        android:name="com.riversongai.ui.RoutinesFragment"
        android:label="Routines"
        tools:layout="@layout/fragment_routines" />

    <!-- ── Placeholder / coming-soon screens ─────────────────────────────── -->

    <fragment
        android:id="@+id/inventoryFragment"
        android:name="com.riversongai.ui.InventoryFragment"
        android:label="Inventory"
        tools:layout="@layout/fragment_inventory" />

    <fragment
        android:id="@+id/maintenanceFragment"
        android:name="com.riversongai.ui.MaintenanceFragment"
        android:label="Maintenance"
        tools:layout="@layout/fragment_maintenance" />

    <fragment
        android:id="@+id/storeFragment"
        android:name="com.riversongai.ui.StoreFragment"
        android:label="Store"
        tools:layout="@layout/fragment_store" />

    <fragment
        android:id="@+id/homeNodeFragment"
        android:name="com.riversongai.ui.HomeNodeFragment"
        android:label="Home Node"
        tools:layout="@layout/fragment_home_node" />

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.riversongai.ui.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <fragment
        android:id="@+id/googleFragment"
        android:name="com.riversongai.ui.GoogleFragment"
        android:label="Google"
        tools:layout="@layout/fragment_google" />

    <fragment
        android:id="@+id/readingFragment"
        android:name="com.riversongai.ui.ReadingFragment"
        android:label="Reading"
        tools:layout="@layout/fragment_reading" />

    <fragment
        android:id="@+id/culinaryFragment"
        android:name="com.riversongai.ui.CulinaryFragment"
        android:label="Culinary"
        tools:layout="@layout/fragment_culinary" />

    <fragment
        android:id="@+id/usersFragment"
        android:name="com.riversongai.ui.UsersFragment"
        android:label="Users"
        tools:layout="@layout/fragment_users" />

    <!-- ── Account / settings ────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.riversongai.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/userDashboardScreen"
        android:name="com.riversongai.ui.UserDashboardScreen"
        android:label="Profile"
        tools:layout="@layout/fragment_user_dashboard" />

    <!-- ── Sub-screens (no bottom nav) ───────────────────────────────────── -->

    <fragment
        android:id="@+id/feedSettingsFragment"
        android:name="com.riversongai.ui.FeedSettingsFragment"
        android:label="Feed Settings"
        tools:layout="@layout/fragment_feed_settings" />

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.riversongai.ui.MoreFragment"
        android:label="More"
        tools:layout="@layout/fragment_more">
        <action
            android:id="@+id/action_moreFragment_to_memoryFragment"
            app:destination="@id/memoryFragment" />
        <action
            android:id="@+id/action_moreFragment_to_routinesFragment"
            app:destination="@id/routinesFragment" />
        <action
            android:id="@+id/action_moreFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_moreFragment_to_feedSettingsFragment"
            app:destination="@id/feedSettingsFragment" />
        <action
            android:id="@+id/action_moreFragment_to_culinaryFragment"
            app:destination="@id/culinaryFragment" />
        <action
            android:id="@+id/action_moreFragment_to_analyticsFragment"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_moreFragment_to_smartHomeControlScreen"
            app:destination="@id/smartHomeControlScreen" />
        <action
            android:id="@+id/action_moreFragment_to_usersFragment"
            app:destination="@id/usersFragment" />
    </fragment>


</navigation>
