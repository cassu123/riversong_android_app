<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/river_song_outline_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/textViewSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session Title"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textViewSessionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="May 3, 2026"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/river_song_on_surface_variant" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/textViewSessionModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-4o"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/river_song_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/textViewMessageCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 msgs"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/river_song_on_surface_variant" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
