<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- Release: riversongai.com via Cloudflare HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">riversongai.com</domain>
    </domain-config>

    <!--
        Debug builds only — allows plain HTTP to your local backend server.
        10.0.2.2 = Android emulator pointing to your dev machine.
        For a real phone on your home WiFi, change 10.0.2.2 to your
        backend machine's LAN IP (e.g. 192.168.1.50) in build.gradle BASE_URL.
        This entire block is stripped from release builds.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- All other traffic defaults to HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
